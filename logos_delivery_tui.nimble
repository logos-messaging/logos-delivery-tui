#!fmt: off

# Package

version       = "0.1.0"
author        = "Zoltan Peter Nagy"
description   = "Terminal UI and headless scenario runner around an in-process LogosDelivery node"
license       = "MIT or Apache License 2.0"
srcDir        = "src"
bin           = @["logos_delivery_tui"]
skipDirs      = @["tests"]

const RequiredNimblePin = "0.26.0"
  ## Same Nimble release logos-delivery builds with.

# Dependencies

requires "nim == 2.2.6"
# Nimble cannot solve logos-delivery's graph from .nimble files alone; the
# build goes through nimble.lock, generated by scripts/gen_lock.py from
# logos-delivery's own lock. Bump a pin here => re-run gen_lock.py.

# logos-delivery master, pinned; bump deliberately (DESIGN.md D12).
requires "https://github.com/logos-messaging/logos-delivery#8a975a94ed0ae7ed635295635d7a5f817958793a"
# v3.4.1 (BrokerScope); logos-delivery pins v3.4.0. gen_lock.py --brokers-rev
# puts this one in the lock, and logos-delivery builds against it.
requires "https://github.com/NagyZoltanPeter/nim-brokers.git#02d6f4bb26c94a44a80383f8827fd59b4e32e97f"
# From the nimble registry; gen_lock.py --illview-rev v0.1.0 locks the release.
requires "illview >= 0.1.0"
# Versions come from logos-delivery's lock.
requires "chronos", "chronicles", "results", "stew"

# Tasks

import std/[os, strutils]

proc pkgDir(prefix: string): string =
  ## Newest installed package dir under nimbledeps/pkgs2 (or ~/.nimble/pkgs2).
  for root in [thisDir() / "nimbledeps" / "pkgs2", getHomeDir() / ".nimble" / "pkgs2"]:
    let best = gorge("ls -dt \"" & root & "/" & prefix & "-\"* 2>/dev/null | head -1").strip
    if best.len > 0:
      return best
  raise newException(OSError, "package " & prefix & " not installed, run `nimble setup --localdeps` first")

task buildNativeDeps, "Build the C libraries logos-delivery links (nat-libs, bearssl, leopard cmake stubs)":
  ## Mirrors logos-delivery's Nat.mk / BearSSL.mk / Leopard.mk for POSIX hosts.
  let cc = getEnv("CC", "cc")
  let march = if gorge("uname -m").strip == "x86_64": " -mssse3" else: ""

  let nat = pkgDir("nat_traversal")
  # Remove archives the nat_traversal install hook left behind: macOS
  # `libtool -static` rebuilds them from only the out-of-date objects.
  rmFile nat / "vendor/miniupnp/miniupnpc/build/libminiupnpc.a"
  rmFile nat / "vendor/libnatpmp-upstream/libnatpmp.a"
  exec "make -C \"" & nat & "/vendor/miniupnp/miniupnpc\" CC=" & cc &
       " CFLAGS=\"-Os -fPIC" & march & "\" build/libminiupnpc.a"
  exec "make -C \"" & nat & "/vendor/libnatpmp-upstream\" CC=" & cc &
       " CFLAGS=\"-Wall -Wno-cpp -Os -fPIC" & march &
       " -DENABLE_STRNATPMPERR -DNATPMP_MAX_RETRIES=4\" libnatpmp.a"

  let bearssl = pkgDir("bearssl")
  exec "make -C \"" & bearssl & "/bearssl/csources\" CFLAGS=\"-W -Wall -Os -fPIC" & march & "\" lib"

  # nimble strips `tests/` from installed packages, but Leopard-RS' CMakeLists
  # still configures these two sources.
  let leoTests = pkgDir("leopard") / "vendor/leopard/tests"
  mkDir leoTests
  for stub in ["benchmark", "experiments"]:
    if not fileExists(leoTests / stub & ".cpp"):
      writeFile(leoTests / stub & ".cpp", "int main() { return 0; }\n")

task tui, "Build and run the TUI; extra args are passed through (default: --node-conf=conf/logos-dev.json)":
  var args: seq[string]
  var passthrough = false
  for a in commandLineParams():
    if passthrough:
      args.add a
    elif a == "tui":
      passthrough = true
  if args.len == 0:
    args = @["--node-conf=conf/logos-dev.json"]
  exec "nim c --hints:off -o:build/logos_delivery_tui src/logos_delivery_tui.nim"
  exec "build/logos_delivery_tui " & args.quoteShellCommand

task test, "Run unit tests":
  for t in ["test_scenario_parse", "test_config_flatten", "test_peer_trees", "test_conf_resolve", "test_node_conf", "test_node_host", "test_echo_filter", "test_log_filter", "test_chat_status"]:
    exec "nim c -r --hints:off -o:build/tests/" & t & " tests/" & t & ".nim"
